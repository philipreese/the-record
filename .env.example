# ListenBrainz credentials
LISTENBRAINZ_USERNAME=your_listenbrainz_username
LISTENBRAINZ_TOKEN=your_listenbrainz_user_token

# Database (optional — defaults to local SQLite at backend/history.db)
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
# DATABASE_PATH=backend/history.db

# Timezone (optional — applied to PostgreSQL sessions; no effect on SQLite)
# TZ=America/New_York

# Logging (optional — controls app.* log verbosity; default is INFO)
# LOG_LEVEL=DEBUG
