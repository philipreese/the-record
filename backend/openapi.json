          }
        },
        "type": "object",
        "required": [
          "month",
          "count"
        ],
        "title": "MonthlyTrendInfo"
      },
      "PlayingNowResponse": {
        "properties": {
          "is_playing": {
            "type": "boolean",
            "title": "Is Playing"
          },
          "artist": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artist"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "release": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release"
          },
          "cover_art_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cover Art Url"
          },
          "last_played": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LastPlayedEntry"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "is_playing"
        ],
        "title": "PlayingNowResponse"
      },
      "StatsSummaryResponse": {
        "properties": {
          "total_listens": {
            "type": "integer",
            "title": "Total Listens"
          },
          "unique_artists": {
            "type": "integer",
            "title": "Unique Artists"
          },
          "unique_tracks": {
            "type": "integer",
            "title": "Unique Tracks"
          },
          "days_active": {
            "type": "integer",
            "title": "Days Active"
          },
          "avg_per_day": {
            "type": "number",
            "title": "Avg Per Day"
          },
          "top_source": {
            "type": "string",
            "title": "Top Source"
          },
          "db_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Db Type"
          },
          "first_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Year"
          }
        },
        "type": "object",
        "required": [
          "total_listens",
          "unique_artists",
          "unique_tracks",
          "days_active",
          "avg_per_day",
          "top_source"
        ],
        "title": "StatsSummaryResponse"
      },
      "StreakStatsResponse": {
        "properties": {
          "current_streak": {
            "type": "integer",
            "title": "Current Streak"
          },
          "longest_streak": {
            "type": "integer",
            "title": "Longest Streak"
          }
        },
        "type": "object",
        "required": [
          "current_streak",
          "longest_streak"
        ],
        "title": "StreakStatsResponse"
      },
      "SyncStartResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "SyncStartResponse"
      },
      "SyncStatusResponse": {
        "properties": {
          "running": {
            "type": "boolean",
            "title": "Running"
          },
          "finished": {
            "type": "boolean",
            "title": "Finished"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "batches_fetched": {
            "type": "integer",
            "title": "Batches Fetched"
