      "WrappedArtist": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "plays": {
            "type": "integer",
            "title": "Plays"
          }
        },
        "type": "object",
        "required": [
          "name",
          "plays"
        ],
        "title": "WrappedArtist"
      },
