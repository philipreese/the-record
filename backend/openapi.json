{
  "openapi": "3.1.0",
  "info": {
    "title": "The Record API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/stats": {
      "get": {
        "summary": "Read Stats",
        "description": "Retrieve high-level listening history metrics.",
        "operationId": "read_stats_api_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsSummaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/top-artists": {
      "get": {
        "summary": "Read Top Artists",
        "description": "Retrieve top artists for a specified time range.",
        "operationId": "read_top_artists_api_top_artists_get",
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "30",
                "90",
                "365",
                "all"
              ],
              "type": "string",
              "description": "Time range in days: 30, 90, 365, or 'all'",
              "default": "all",
              "title": "Range"
            },
            "description": "Time range in days: 30, 90, 365, or 'all'"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Max results to return",
              "default": 15,
              "title": "Limit"
            },
            "description": "Max results to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ArtistInfo"
                  },
                  "title": "Response Read Top Artists Api Top Artists Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/top-tracks": {
      "get": {
        "summary": "Read Top Tracks",
        "description": "Retrieve top tracks for a specified time range.",
        "operationId": "read_top_tracks_api_top_tracks_get",
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "30",
                "90",
                "365",
                "all"
              ],
              "type": "string",
              "description": "Time range in days: 30, 90, 365, or 'all'",
              "default": "all",
              "title": "Range"
            },
            "description": "Time range in days: 30, 90, 365, or 'all'"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Max results to return",
              "default": 15,
              "title": "Limit"
            },
            "description": "Max results to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TrackInfo"
                  },
                  "title": "Response Read Top Tracks Api Top Tracks Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/heatmap": {
      "get": {
        "summary": "Read Heatmap",
        "description": "Retrieve daily play counts for a calendar heatmap visualization.",
        "operationId": "read_heatmap_api_heatmap_get",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2100,
                  "minimum": 2000
                },
                {
                  "type": "null"
                }
              ],
              "description": "The calendar year to display",
              "title": "Year"
            },
            "description": "The calendar year to display"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  },
                  "title": "Response Read Heatmap Api Heatmap Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/trends/hourly": {
      "get": {
        "summary": "Read Hourly Trends",
        "description": "Retrieve play counts grouped by the hour of the day.",
        "operationId": "read_hourly_trends_api_trends_hourly_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "integer"
                  },
                  "type": "object",
                  "title": "Response Read Hourly Trends Api Trends Hourly Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/trends/monthly": {
      "get": {
        "summary": "Read Monthly Trends",
        "description": "Retrieve play counts grouped by month (chronological).",
        "operationId": "read_monthly_trends_api_trends_monthly_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MonthlyTrendInfo"
                  },
                  "type": "array",
                  "title": "Response Read Monthly Trends Api Trends Monthly Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/trends/streak": {
      "get": {
        "summary": "Read Streak",
        "description": "Retrieve active and historical daily listening streaks.",
        "operationId": "read_streak_api_trends_streak_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreakStatsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/wrapped": {
      "get": {
        "summary": "Read Wrapped",
        "description": "Retrieve aggregated review stats for custom time intervals (Spotify Wrapped style).",
        "operationId": "read_wrapped_api_wrapped_get",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2100,
                  "minimum": 2000
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by year (e.g. 2025)",
              "title": "Year"
            },
            "description": "Filter by year (e.g. 2025)"
          },
          {
            "name": "quarter",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "Q1",
                    "Q2",
                    "Q3",
                    "Q4"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by quarter: Q1, Q2, Q3, Q4",
              "title": "Quarter"
            },
            "description": "Filter by quarter: Q1, Q2, Q3, Q4"
          },
          {
            "name": "month",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "M1",
                    "M2",
                    "M3",
                    "M4",
                    "M5",
                    "M6",
                    "M7",
                    "M8",
                    "M9",
                    "M10",
                    "M11",
                    "M12"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by month: M1 to M12",
              "title": "Month"
            },
            "description": "Filter by month: M1 to M12"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WrappedDataResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/recent": {
      "get": {
        "summary": "Read Recent",
        "description": "Retrieve recent listens in reverse-chronological order with cursor-based pagination.",
        "operationId": "read_recent_api_recent_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Max results per page (1–100)",
              "default": 50,
              "title": "Limit"
            },
            "description": "Max results per page (1–100)"
          },
          {
            "name": "before_ts",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Cursor: unix_ts of the last item from the previous page",
              "title": "Before Ts"
            },
            "description": "Cursor: unix_ts of the last item from the previous page"
          },
          {
            "name": "before_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Cursor: id of the last item from the previous page",
              "title": "Before Id"
            },
            "description": "Cursor: id of the last item from the previous page"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ListenEntry"
                  },
                  "title": "Response Read Recent Api Recent Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/playing-now": {
      "get": {
        "summary": "Get Playing Now",
        "description": "Fetch the currently playing track from ListenBrainz, or the most recent listen if nothing is playing.",
        "operationId": "get_playing_now_api_playing_now_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayingNowResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sync": {
      "post": {
        "summary": "Start Sync",
        "description": "Kick off a background sync with ListenBrainz and return immediately.\nPoll GET /api/sync/status for progress and results.",
        "operationId": "start_sync_api_sync_post",
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "normal",
                "full"
              ],
              "type": "string",
              "description": "Sync mode: 'normal' or 'full'",
              "default": "normal",
              "title": "Mode"
            },
            "description": "Sync mode: 'normal' or 'full'"
          },
          {
            "name": "x-sync-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Sync-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncStartResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sync/status": {
      "get": {
        "summary": "Get Sync Status",
        "description": "Return the current state of the background sync job.",
        "operationId": "get_sync_status_api_sync_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncStatusResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArtistInfo": {
        "properties": {
          "artist": {
            "type": "string",
            "title": "Artist"
          },
          "play_count": {
            "type": "integer",
            "title": "Play Count"
          }
        },
        "type": "object",
        "required": [
          "artist",
          "play_count"
        ],
        "title": "ArtistInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LastPlayedEntry": {
        "properties": {
          "artist": {
            "type": "string",
            "title": "Artist"
          },
          "title": {
            "type": "string",
            "title": "Title"
